# Resend — contact form delivery (required for /api/contact to send mail)
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub — raises the API rate limit from 60 to 5,000 req/h.
# Used for: live commit on the right rail, language breakdown bar,
# repo + follower counts. Public-data reads only — a fine-grained
# token with "Public Repositories (read-only)" is enough, or `gh auth token`.
# Without this set the site still works (it falls back to per-repo commits).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — where the contact form delivers messages.
# Defaults to hritik3447@gmail.com (see app/api/contact/route.ts).
# CONTACT_EMAIL=you@example.com
